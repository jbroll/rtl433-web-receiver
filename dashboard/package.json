{
  "name": "rtl433-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "The browser dashboard for the rtl_433 receiver and the MQTT bridge",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && node --run serve",
    "serve": "node -e \"import('node:http').then(({default:h})=>import('node:fs').then(({default:f})=>h.createServer((q,s)=>{s.writeHead(200,{'content-type':'text/html'});s.end(f.readFileSync('dist/index.html'))}).listen(8000,()=>console.log('http://127.0.0.1:8000'))))\"",
    "test": "node --test test/*.test.js && playwright test"
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "esbuild": "^0.24.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
