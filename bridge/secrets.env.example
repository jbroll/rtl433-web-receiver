# Copy to secrets.env (gitignored) and fill in before running `deploy init`.
# AUTH_TOKEN: generate with `openssl rand -hex 24`.
# DASHBOARD_HTML isn't a secret, but this file is the only channel deploy.sh
# gives the node_app module for setting the running service's environment
# (it becomes /etc/mqtt-http-bridge.env, the systemd unit's EnvironmentFile).
AUTH_TOKEN=
TLS_CERT=/etc/letsencrypt/live/weather.rkroll.com/fullchain.pem
TLS_KEY=/etc/letsencrypt/live/weather.rkroll.com/privkey.pem
DASHBOARD_HTML=/var/www/mqtt-http-bridge/public/index.html
